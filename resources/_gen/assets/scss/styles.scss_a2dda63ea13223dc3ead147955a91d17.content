:0;width:2px;height:20px;margin-top:-2px;background-color:var(--title-color);border-radius:1px;transition:top .3s ease;pointer-events:none;z-index:2}.work-toc ul{list-style:none;padding:0;margin:0;font-size:inherit}.work-toc li{margin-bottom:.5rem;position:relative}.work-toc a{text-decoration:none;display:inline-block;color:var(--text-color);opacity:.5;transition:color .2s ease,opacity .2s ease}.work-toc a:hover{opacity:.85}.work-toc a.active{color:var(--title-color);opacity:1;font-weight:500}.truncated-text{overflow:hidden;white-space:nowrap;text-overflow:ellipsis}.preview-box{position:fixed;top:0;left:0;z-index:1000;pointer-events:none;opacity:0;visibility:hidden;transform:scale(.96);transition:opacity 200ms ease,transform 200ms ease,visibility 200ms ease}.preview-box.visible{opacity:1;visibility:visible;transform:scale(1)}.preview-box img{max-width:200px;max-height:150px;border-radius:6px;box-shadow:0 4px 16px rgba(0,0,0,.15);display:block}.scroll-deck{--card-w:200px;--spread:200px;--tilt:3.5deg;--rest:3px;--rest-rot:1.5deg;--radius:10px;position:relative;height:150vh;margin:40px 0 0;width:100vw;margin-left:calc(50% - 50vw);margin-right:calc(50% - 50vw)}.scroll-deck__stage{--stage-h:calc(var(--card-w) * 4 / 3 + 44px);position:sticky;top:calc((100vh - var(--stage-h))/2);top:calc((100svh - var(--stage-h))/2);height:var(--stage-h);display:flex;align-items:center;justify-content:center;overflow:hidden}.scroll-deck__cards{position:relative;width:100%;height:100%}.deck-card{position:absolute;left:50%;top:50%;width:var(--card-w);height:calc(var(--card-w) * 4/3);border-radius:var(--radius);overflow:hidden;background:var(--base-color);will-change:transform;transform:translate(-50%,-50%)translateX(calc(var(--xf) * var(--rest)))rotate(calc(var(--xf) * var(--rest-rot)))}.deck-card__img,.deck-card__fill{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}.deck-card__fill{background:repeating-linear-gradient(45deg,var(--hover-color),var(--hover-colo